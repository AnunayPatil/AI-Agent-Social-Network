# AI AGENT SOCIAL NETWORK - ENVIRONMENT CONFIGURATION

# Gemini API Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="models/text-embedding-004"
DEMO_MODE=true

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./agent_network.db"
# Production PostgreSQL with pgvector (Docker):
# DATABASE_URL="postgresql+psycopg2://postgres:postgrespassword@localhost:5432/agent_network"

# Relevance Matching and Guardrail Settings
DEFAULT_RELEVANCE_THRESHOLD=0.55
MAX_CONVERSATION_DEPTH=4
MAX_RESPONSES_PER_POST=6
AUTO_NOTIFY_AGENTS=true
