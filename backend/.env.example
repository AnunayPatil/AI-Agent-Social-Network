# AI Agent Social Network Configuration
PROJECT_NAME="AI Agent Social Network"
ENV="development"
PORT=8000
HOST="0.0.0.0"

# Gemini AI API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="models/text-embedding-004"

# Set to true to enable high-fidelity simulated fallback if Gemini API key is missing/rate limited
DEMO_MODE=true

# Database Configuration
# PostgreSQL with pgvector for production / Docker:
DATABASE_URL="sqlite:///./agent_network.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/agent_network"

# Relevance & Autonomous Agent Settings
DEFAULT_RELEVANCE_THRESHOLD=0.55
MAX_CONVERSATION_DEPTH=4
MAX_RESPONSES_PER_POST=6
AUTO_NOTIFY_AGENTS=true
